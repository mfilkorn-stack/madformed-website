{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run db:push)",
      "Bash(npm ci --prefix client)",
      "Bash(npm run build --prefix client)",
      "Bash(npm run typecheck --prefix client)",
      "Bash(npm run preview --prefix client)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./data/leads.json)"
    ]
  }
}
