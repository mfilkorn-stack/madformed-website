Options -MultiViews
DirectoryIndex index.html

# Kein automatischer 301 auf Trailing-Slash-URLs. Die prerenderten Routen
# werden ohne Trailing Slash kanonisiert und direkt ausgeliefert.
DirectorySlash Off

# ---------------------------------------------------------------------------
# SPA Routing — all unknown paths fall back to index.html
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # noindex-Markierung fuer die nicht prerenderten Hilfsrouten. Muss vor dem
  # SPA-Fallback stehen, danach zeigt REQUEST_URI auf /index.html. Der Header
  # selbst wird weiter unten im mod_headers-Block gesetzt.
  RewriteCond %{REQUEST_URI} ^/(en/)?case-report/?$ [OR]
  RewriteCond %{REQUEST_URI} ^/mockup/?$
  RewriteRule ^ - [E=NOINDEX_PAGE:1]

  # Prerenderte Route: Verzeichnis mit index.html direkt ausliefern,
  # ohne Redirect auf die Trailing-Slash-Variante.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Do not rewrite files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA-Fallback nur fuer Pfade ohne eigene Datei (z. B. /case-report, 404)
  RewriteRule ^ /index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Security Headers (OWASP recommended baseline)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking protection
  Header always set X-Frame-Options "SAMEORIGIN"

  # Referrer information control
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy — disable unused browser features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"

  # Content Security Policy
  # - Google Fonts/Analytics/Ads are explicitly allowed (used in index.html)
  # - 'unsafe-inline' for styles is required by Tailwind CSS
  # - Adjust if adding new third-party scripts
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://googleads.g.doubleclick.net; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self';"

  # HSTS — enforce HTTPS for 1 year (only takes effect on HTTPS connections)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Remove server identification header
  Header always unset X-Powered-By

  # Nicht prerenderte Hilfsrouten aus dem Index halten. Bewusst kein
  # robots.txt-Disallow: sonst koennte der Crawler diesen Header nie lesen.
  # Gesetzt von der NOINDEX_PAGE-Regel im mod_rewrite-Block oben. Nach dem
  # internen Rewrite auf /index.html traegt die Variable das REDIRECT_-Praefix,
  # deshalb beide Schreibweisen.
  Header always set X-Robots-Tag "noindex, nofollow" env=NOINDEX_PAGE
  Header always set X-Robots-Tag "noindex, nofollow" env=REDIRECT_NOINDEX_PAGE

  # Cache-Control for index.html — must not be cached to pick up new deploys
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # Long-term immutable caching for content-hashed assets
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Correct MIME types
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/xml .xml
  AddType text/plain .txt
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------------------------------------------------------------------------
# Compression (Brotli preferred, Gzip fallback)
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Block access to hidden files and directories (e.g. .git, .env)
# ---------------------------------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ---------------------------------------------------------------------------
# Block access to source map files in production
# ---------------------------------------------------------------------------
<FilesMatch "\.map$">
  Require all denied
</FilesMatch>
